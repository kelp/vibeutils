#!/bin/sh
# Block the commit on two gates: `zig fmt` cleanliness, and NEW Tiger Style
# violations introduced by the staged change.
#
# Gate 1 (zig fmt): we always want formatting auto-fixed, so when it is not
# clean this hook runs the formatter and ABORTS -- letting you review the
# reformatted files and re-commit. When already clean (the common case, since
# the dev and the TDD workflow run `just fmt`), this is a fast no-op.
#
# Gate 2 (Tiger Style): scripts/tiger-check.sh --staged scans the staged
# src/*.zig and fails ONLY on violations this change INTRODUCES; pre-existing
# debt is reported, not blocked, so the in-progress migration's existing
# violations do not brick commits. The scanner cannot auto-fix, so it just
# names the offending lines and aborts. A scanner error never blocks a commit.
#
# Installed via `just install-hooks` (sets core.hooksPath to .githooks).

# --- Gate 1: formatting ---
if ! zig build fmt-check >/dev/null 2>&1; then
    echo "pre-commit: Zig formatting is not clean. Running 'zig build fmt' to fix it..." >&2
    if ! zig build fmt >/dev/null 2>&1; then
        echo "pre-commit: 'zig build fmt' failed -- fix the build, then re-commit." >&2
        exit 1
    fi
    echo "pre-commit: formatting fixed in your working tree. Review the changes, stage them, and re-commit." >&2
    exit 1
fi

# --- Gate 2: no NEW Tiger Style violations ---
if [ -x scripts/tiger-check.sh ]; then
    tiger_output=$(scripts/tiger-check.sh --staged 2>/dev/null)
    tiger_status=$?
    if [ "$tiger_status" -eq 1 ]; then
        echo "pre-commit: this change introduces NEW Tiger Style violations:" >&2
        printf '%s\n' "$tiger_output" | awk -F'\t' '$3 == "NEW" { print "  " $1 "  " $2 "  " $4 }' >&2
        echo "" >&2
        echo "Fix them and re-commit. Pre-existing violations are not blocked -- only ones this" >&2
        echo "change introduces. If a flagged line is legitimate dual-use (a usize required by a" >&2
        echo "std API, or a provably-bounded 'while (true)'), that is a judgment call -- review it." >&2
        exit 1
    elif [ "$tiger_status" -ne 0 ]; then
        echo "pre-commit: tiger-check.sh exited $tiger_status (not a violation); skipping Tiger gate." >&2
    fi
fi

exit 0
