{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(zig:*)",
      "Bash(just:*)",
      "Bash(zig-out/bin/*:*)",
      "Bash(./zig-out/bin/*:*)",
      "Bash(timeout:*)",
      "Bash(mandoc:*)",
      "Bash(fakeroot:*)",
      "Bash(chmod:*)",
      "Bash(bash:*)",
      "Bash(/opt/homebrew/bin/bash:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(scripts/bootstrap.sh:*)",
      "Bash(./scripts/bootstrap.sh:*)",
      "Bash(scripts/tiger-check.sh:*)",
      "Bash(./scripts/tiger-check.sh:*)",
      "Bash(scripts/lint-man-pages.sh:*)",
      "Bash(./scripts/lint-man-pages.sh:*)",
      "Bash(scripts/run-privileged-tests.sh:*)",
      "Bash(./scripts/run-privileged-tests.sh:*)",
      "Bash(tests/integration.sh:*)",
      "Bash(./tests/integration.sh:*)",
      "Bash(xxd:*)",
      "Bash(ls:*)",
      "WebSearch",
      "WebFetch(domain:ziggit.dev)",
      "WebFetch(domain:pubs.opengroup.org)",
      "WebFetch(domain:man.openbsd.org)",
      "WebFetch(domain:www.gnu.org)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$TOOL_INPUT_file_path\" in *.zig) zig fmt \"$TOOL_INPUT_file_path\" 2>/dev/null || true ;; esac"
          },
          {
            "type": "command",
            "command": "case \"$TOOL_INPUT_file_path\" in */man1/*.1) mandoc -T lint \"$TOOL_INPUT_file_path\" 2>&1 || true ;; esac"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT_file_path\" | grep -qE '(zig-out|zig-cache|\\.zig-cache|docs/html)/' && echo 'BLOCK: Do not edit build artifacts' && exit 1; exit 0"
          },
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT_file_path\" | grep -q 'build.zig.zon' && echo 'BLOCK: Use just release x.y.z to change versions. Do not edit build.zig.zon directly.' && exit 1; exit 0"
          }
        ]
      }
    ]
  }
}
